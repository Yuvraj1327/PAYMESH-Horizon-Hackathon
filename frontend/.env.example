# PayMesh frontend — environment template. PLACEHOLDERS ONLY: never commit real values.
# Everything here is NEXT_PUBLIC_* and therefore visible in the browser. Secrets (Supabase service-role key,
# Anthropic key, HSP credentials) live ONLY on the FastAPI backend and must never be added to this file.
#
# Environment separation (set per environment in Vercel → Settings → Environment Variables):
#   Development / local : copy to .env.local, API on http://localhost:8000, chain 133 (testnet)
#   Preview             : staging backend (https), chain 133 (testnet)
#   Production          : production backend (https), chain 133 until real-fund payments are explicitly approved

NEXT_PUBLIC_APP_NAME=PayMesh
# Canonical site URL (used for Open Graph/metadata). Production example: https://paymesh.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend base URL. https is required except for localhost. EMPTY = clearly-labelled DEMO MODE (no sign-in, no backend).
NEXT_PUBLIC_API_BASE_URL=

# Supabase project URL + anon (public) key. The anon key is public by design; Row Level Security protects data.
# Both are required whenever NEXT_PUBLIC_API_BASE_URL is set (the backend only accepts a verified Supabase JWT).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HashKey Chain the UI targets: 133 = testnet, 177 = mainnet (real funds; a red banner is shown in the app).
# Verified: testnet RPC https://testnet.hsk.xyz, mainnet RPC https://mainnet.hsk.xyz (configured in src/lib/web3/chains.ts).
NEXT_PUBLIC_HSK_CHAIN_ID=133

# Optional block-explorer base URLs (https). Empty on purpose: explorer links appear only for URLs you have verified.
NEXT_PUBLIC_EXPLORER_URL_133=
NEXT_PUBLIC_EXPLORER_URL_177=
