# ---- App ------------------------------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000  # comma-separated list of allowed frontend origins
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_MINUTE=20

# ---- Database (Supabase Postgres) -------------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string. postgresql:// is auto-converted to asyncpg.
# With the transaction pooler (port 6543) prepared statements are disabled automatically.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Supabase Auth ------------------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only; not needed by Step 1 endpoints
# Legacy projects (HS256 JWT secret). Projects with asymmetric signing keys are verified via JWKS and can leave this empty.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- Anthropic (Claude) -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5   # configurable
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_TOKENS=1500
AI_MAX_CALLS_PER_USER_PER_DAY=200
AI_MAX_TOKENS_PER_USER_PER_DAY=400000

# ---- HSP / HashKey Merchant (names follow the official docs: app_key, app_secret, merchant ES256K key) ------------
# QA (testnet tokens only)      : https://merchant-qa.hashkeymerchant.com   -> HSK_CHAIN_ID=133
# Staging (mainnet tokens only) : https://merchant-stg.hashkeymerchant.com  -> HSK_CHAIN_ID=177
# Production (mainnet only)     : https://hsp.hashkey.com                   -> HSK_CHAIN_ID=177
# The backend REFUSES to create orders if host and chain id are mixed (and refuses to boot that way in production).
HSP_BASE_URL=https://merchant-qa.hashkeymerchant.com
HSP_APP_KEY=                          # from the merchant console after onboarding (header X-App-Key)
HSP_APP_SECRET=                       # HMAC key + webhook key. SERVER ONLY.
HSP_MERCHANT_NAME=PayMesh
# secp256k1 key whose PUBLIC half you registered with HashKey during onboarding (signs the Cart Mandate JWT).
# Use ONE of the two. It cannot move funds, but it authorizes orders in your name: protect it like a password.
HSP_MERCHANT_PRIVATE_KEY_FILE=        # e.g. /etc/paymesh/merchant_private_key.pem
HSP_MERCHANT_PRIVATE_KEY_PEM=         # or the PEM with \n escapes (Railway/Render secrets)
HSP_REDIRECT_URL=                     # optional: where HSP sends the payer after checkout
HSP_SETTLEMENT_MIN_STATUS=payment-finalized   # or payment-safe (still independently verified on-chain)
HSP_ONCHAIN_CHECK=strict              # strict | tx_only | off  (production always behaves as strict)
HSP_MIN_CONFIRMATIONS=12              # fallback when the RPC has no 'finalized' tag
HSP_AMOUNT_SHORTFALL_BPS=0            # tolerated on-chain shortfall (basis points); tune only after a real QA payment
HSP_BACKGROUND_POLL=false             # true = in-process poller (run on ONE instance); webhooks are the primary signal
HSP_POLL_INTERVAL_SECONDS=15
HSP_POLL_MIN_INTERVAL_SECONDS=5
HSP_CART_EXPIRY_MINUTES=120

# ---- HashKey Chain ------------------------------------------------------------------------------------
HSK_RPC_URL=https://testnet.hsk.xyz   # mainnet: https://mainnet.hsk.xyz
HSK_CHAIN_ID=133                      # mainnet: 177
AGENT_REGISTRY_ADDRESS=               # set after deploying contracts/AgentRegistry.sol

# ---- Platform allow-lists (asset SYMBOLS only; token addresses are a Step 2 item from the official guide) ----
SUPPORTED_ASSETS=USDT                 # USDT and/or USDC (both are in the official HSP table for chains 133/177)
ALLOWED_CHAIN_IDS=133,177
PAYMENT_INTENT_TTL_MINUTES=30
QUOTATION_TTL_MINUTES=60

# ---- Demo provider payout wallets (addresses YOU control; never put private keys here) ---------------------
DEMO_CRYPTO_RESEARCH_WALLET=
DEMO_MARKET_DATA_WALLET=
DEMO_AI_ANALYTICS_WALLET=
